generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  /// Business vertical (see src/shared/verticals). Drives enabled modules, attributes schema and UI.
  vertical       String   @default("dental")
  enabledModules String[] @default([]) @map("enabled_modules")
  /// IANA time zone; working hours and availability are computed in it
  timezone       String   @default("America/Argentina/Buenos_Aires")
  /// ISO 4217 currency for catalog prices and sales
  currency       String   @default("ARS")
  /// Sales tax in basis points (2100 = 21%), added on top of tax-exclusive prices. 0 = prices are final.
  taxRateBps     Int      @default(0) @map("tax_rate_bps")
  /// Last sale number issued (atomic counter for sequential numbering)
  saleCounter    Int      @default(0) @map("sale_counter")
  /// Last work order number issued (atomic counter)
  workOrderCounter Int    @default(0) @map("work_order_counter")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships  Membership[]
  roles        Role[]
  customers    Customer[]
  appointments Appointment[]
  staffMembers StaffMember[]
  resources    Resource[]
  catalogItems   CatalogItem[]
  sales          Sale[]
  stockMovements StockMovement[]
  cashSessions CashSession[]
  subscription Subscription?

  @@map("organizations")
}

model Membership {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  roleId         String   @map("role_id")
  isActive       Boolean  @default(true) @map("is_active")
  joinedAt       DateTime @default(now()) @map("joined_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Role {
  id             String   @id @default(uuid())
  name           String
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships     Membership[]
  rolePermissions RolePermission[]

  @@unique([name, organizationId])
  @@map("roles")
}

model Permission {
  id       String @id @default(uuid())
  resource String
  action   String

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Customer {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  email          String?
  phone          String?
  documentId     String?  @map("document_id")
  /// Vertical-specific fields, validated against the organization's vertical schema.
  attributes     Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  sales           Sale[]
  clinicalRecord  ClinicalRecord?
  clinicalNotes   ClinicalNote[]
  toothConditions ToothCondition[]
  treatmentPlans  TreatmentPlan[]
  attachments     ClinicalAttachment[]
  assets          Asset[]
  workOrders      WorkOrder[]

  @@index([organizationId])
  @@index([organizationId, documentId])
  @@map("customers")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  customerId     String            @map("customer_id")
  staffId        String            @map("staff_id")
  resourceId     String?           @map("resource_id")
  /// Optional catalog service booked (sets the default duration; used to bill the appointment)
  serviceId      String?           @map("service_id")
  title          String
  description    String?
  startTime      DateTime          @map("start_time")
  endTime        DateTime          @map("end_time")
  status         AppointmentStatus @default(SCHEDULED)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff        StaffMember  @relation(fields: [staffId], references: [id])
  resource     Resource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  service      CatalogItem? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  sale         Sale?

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, status])
  @@index([customerId, startTime, endTime])
  @@index([staffId, startTime, endTime])
  @@index([resourceId, startTime, endTime])
  @@map("appointments")
}

// ─── STAFF & SCHEDULING ─────────────────────────────────────────────────────

/// Person who attends appointments (dentist, mechanic, stylist…). May or may not be a system user.
model StaffMember {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  name           String
  specialty      String?
  color          String   @default("#2563eb")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workingHours WorkingHours[]
  timeOff      TimeOff[]
  appointments Appointment[]
  sales        Sale[]
  workOrders   WorkOrder[]

  @@index([organizationId])
  @@map("staff_members")
}

/// Weekly working window, in the organization's time zone.
model WorkingHours {
  id          String @id @default(uuid())
  staffId     String @map("staff_id")
  /// ISO weekday: 1 = Monday … 7 = Sunday
  weekday     Int
  /// Minutes from local midnight, [start, end)
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("working_hours")
}

model TimeOff {
  id        String   @id @default(uuid())
  staffId   String   @map("staff_id")
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startTime])
  @@map("time_off")
}

/// Bookable resource (chair, room, lift…). Optional on appointments.
model Resource {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([organizationId])
  @@map("resources")
}

// ─── CATALOG & SALES ────────────────────────────────────────────────────────

enum CatalogItemType {
  SERVICE
  PRODUCT
}

model CatalogItem {
  id              String          @id @default(uuid())
  organizationId  String          @map("organization_id")
  type            CatalogItemType
  name            String
  sku             String?
  /// Price in minor units (cents)
  price           Int
  /// Services only: default appointment duration
  durationMinutes Int?            @map("duration_minutes")
  /// Products only: whether inventory tracks this item (Phase 4)
  trackStock      Boolean         @default(false) @map("track_stock")
  /// Current stock (only meaningful when trackStock). Changed only through the stock ledger.
  stockQuantity   Int             @default(0) @map("stock_quantity")
  /// Low-stock alert threshold (null = no alert)
  minStock        Int?            @map("min_stock")
  attributes      Json            @default("{}")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  appointments   Appointment[]
  stockMovements StockMovement[]
  treatmentItems TreatmentPlanItem[]
  workOrderItems WorkOrderItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, type])
  @@map("catalog_items")
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  VOIDED
}

model Sale {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  /// Sequential per organization
  number         Int
  customerId     String?    @map("customer_id")
  staffId        String?    @map("staff_id")
  appointmentId  String?    @unique @map("appointment_id")
  status         SaleStatus @default(DRAFT)
  /// All amounts in minor units (cents)
  subtotal       Int        @default(0)
  discountTotal  Int        @default(0) @map("discount_total")
  globalDiscount Int        @default(0) @map("global_discount")
  taxRateBps     Int        @default(0) @map("tax_rate_bps")
  taxTotal       Int        @default(0) @map("tax_total")
  total          Int        @default(0)
  paidTotal      Int        @default(0) @map("paid_total")
  notes          String?
  confirmedAt    DateTime?  @map("confirmed_at")
  voidedAt       DateTime?  @map("voided_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staff        StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       Payment[]
  stockMovements StockMovement[]
  treatmentItems TreatmentPlanItem[]

  @@unique([organizationId, number])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@map("sales")
}

model SaleItem {
  id            String  @id @default(uuid())
  saleId        String  @map("sale_id")
  catalogItemId String? @map("catalog_item_id")
  description   String
  quantity      Int
  /// Price frozen at sale time (cents)
  unitPrice     Int     @map("unit_price")
  /// Line discount (cents)
  discount      Int     @default(0)
  total         Int
  position      Int

  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@map("sale_items")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

model Payment {
  id            String        @id @default(uuid())
  saleId        String        @map("sale_id")
  cashSessionId String?       @map("cash_session_id")
  method        PaymentMethod
  amount        Int
  createdBy     String        @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([cashSessionId])
  @@map("payments")
}

/// Daily cash register. At most one open session per organization (partial unique index in SQL).
model CashSession {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  openedBy       String    @map("opened_by")
  openedAt       DateTime  @default(now()) @map("opened_at")
  openingAmount  Int       @map("opening_amount")
  closedBy       String?   @map("closed_by")
  closedAt       DateTime? @map("closed_at")
  /// Cash counted at close
  countedCash    Int?      @map("counted_cash")
  /// openingAmount + cash payments, computed at close
  expectedCash   Int?      @map("expected_cash")
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([organizationId, openedAt])
  @@map("cash_sessions")
}

// ─── INVENTORY ──────────────────────────────────────────────────────────────

enum StockMovementType {
  PURCHASE
  ADJUSTMENT
  SALE
  SALE_VOID
}

/// Append-only stock ledger. `quantity` is the signed change; `balanceAfter` the resulting stock.
model StockMovement {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  catalogItemId  String            @map("catalog_item_id")
  type           StockMovementType
  quantity       Int
  balanceAfter   Int               @map("balance_after")
  saleId         String?           @map("sale_id")
  note           String?
  createdBy      String?           @map("created_by")
  createdAt      DateTime          @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogItem  CatalogItem  @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([catalogItemId, createdAt])
  @@index([saleId])
  @@map("stock_movements")
}

// ─── CLINICAL (dental vertical) ─────────────────────────────────────────────

/// Medical history (anamnesis), one per customer. Fields defined by the vertical template.
model ClinicalRecord {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  customerId     String   @unique @map("customer_id")
  anamnesis      Json     @default("{}")
  updatedBy      String?  @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("clinical_records")
}

/// Progress notes. Append-only: never edited or deleted (clinical record integrity).
model ClinicalNote {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  customerId     String   @map("customer_id")
  authorId       String   @map("author_id")
  /// Author name snapshot at writing time
  authorName     String   @map("author_name")
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("clinical_notes")
}

/// Odontogram as an append-only log: current state = latest entry per (tooth, surface).
model ToothCondition {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  customerId     String   @map("customer_id")
  /// FDI notation: 11–48 permanent, 51–85 deciduous
  tooth          Int
  /// O, M, D, V, L — or null for the whole tooth
  surface        String?
  condition      String
  notes          String?
  recordedBy     String   @map("recorded_by")
  createdAt      DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, tooth, createdAt])
  @@map("tooth_conditions")
}

enum TreatmentItemStatus {
  PROPOSED
  ACCEPTED
  DONE
  DISCARDED
}

model TreatmentPlan {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  customerId     String   @map("customer_id")
  title          String
  notes          String?
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  customer Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    TreatmentPlanItem[]

  @@index([organizationId, customerId])
  @@map("treatment_plans")
}

model TreatmentPlanItem {
  id             String              @id @default(uuid())
  planId         String              @map("plan_id")
  organizationId String              @map("organization_id")
  catalogItemId  String?             @map("catalog_item_id")
  /// Service name snapshot
  description    String
  /// FDI tooth (optional) and surface (optional)
  tooth          Int?
  surface        String?
  /// Price snapshot in cents (editable while PROPOSED)
  price          Int
  status         TreatmentItemStatus @default(PROPOSED)
  doneAt         DateTime?           @map("done_at")
  /// Sale that billed this item. Items whose sale was voided can be billed again.
  saleId         String?             @map("sale_id")
  position       Int
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  plan        TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem?  @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  sale        Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([saleId])
  @@map("treatment_plan_items")
}

/// Clinical files (x-rays, documents). Stored outside the DB; `storageKey` never derives from user input.
model ClinicalAttachment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  customerId     String   @map("customer_id")
  filename       String
  mimeType       String   @map("mime_type")
  size           Int
  storageKey     String   @unique @map("storage_key")
  description    String?
  uploadedBy     String   @map("uploaded_by")
  createdAt      DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@map("clinical_attachments")
}

// ─── WORK ORDERS (repair verticals) ─────────────────────────────────────────

/// Customer's equipment: a vehicle, a device… Fields defined by the vertical (assetAttributes).
model Asset {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  customerId     String   @map("customer_id")
  /// Short display name, e.g. "Ford Fiesta · AB123CD"
  label          String
  attributes     Json     @default("{}")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]

  @@index([organizationId, customerId])
  @@map("assets")
}

enum WorkOrderStatus {
  RECEIVED
  DIAGNOSING
  QUOTED
  APPROVED
  IN_PROGRESS
  READY
  DELIVERED
  REJECTED
  CANCELLED
}

model WorkOrder {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  /// Sequential per organization
  number         Int
  customerId     String          @map("customer_id")
  assetId        String?         @map("asset_id")
  /// Assigned technician
  staffId        String?         @map("staff_id")
  status         WorkOrderStatus @default(RECEIVED)
  reportedIssue  String          @map("reported_issue")
  diagnosis      String?
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  customer Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  asset    Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  staff    StaffMember?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  items    WorkOrderItem[]
  events   WorkOrderEvent[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@map("work_orders")
}

/// Parts (products) and labor (services) of the quote. Prices in cents.
model WorkOrderItem {
  id             String  @id @default(uuid())
  workOrderId    String  @map("work_order_id")
  organizationId String  @map("organization_id")
  catalogItemId  String? @map("catalog_item_id")
  description    String
  quantity       Int
  unitPrice      Int     @map("unit_price")
  position       Int

  workOrder   WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@map("work_order_items")
}

/// Status history (who/when/why), append-only.
model WorkOrderEvent {
  id          String           @id @default(uuid())
  workOrderId String           @map("work_order_id")
  fromStatus  WorkOrderStatus? @map("from_status")
  toStatus    WorkOrderStatus  @map("to_status")
  note        String?
  userId      String           @map("user_id")
  userName    String           @map("user_name")
  createdAt   DateTime         @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId, createdAt])
  @@map("work_order_events")
}

// ─── BILLING ────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model Plan {
  id              String   @id @default(uuid())
  name            String   @unique  // 'free' | 'pro' | 'enterprise'
  displayName     String   @map("display_name")
  price           Decimal  @db.Decimal(10, 2)
  currency        String   @default("USD")
  features        String[]
  maxCustomers    Int      @map("max_customers")     // -1 = unlimited
  maxAppointments Int      @map("max_appointments")  // -1 = unlimited
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id             String             @id @default(uuid())
  organizationId String             @unique @map("organization_id")
  planId         String             @map("plan_id")
  status         SubscriptionStatus @default(ACTIVE)
  startDate      DateTime           @map("start_date")
  endDate        DateTime?          @map("end_date")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model UsageRecord {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  metric         String   // 'customers' | 'appointments'
  count          Int      @default(0)
  period         String   // 'all-time' | 'YYYY-MM'
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, metric, period])
  @@index([organizationId])
  @@map("usage_records")
}
