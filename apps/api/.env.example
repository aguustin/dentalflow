# API environment. Copy to apps/api/.env (git-ignored) and fill in real values.
# NEVER commit apps/api/.env — it holds secrets.

# ── Database (docker-compose maps Postgres to localhost:5434 by default) ─────
DATABASE_URL=postgresql://dentalflow:dentalflow_secret@localhost:5434/dentalflow_dev

# ── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Clinical attachments storage (local disk in development) ─────────────────
# UPLOADS_DIR=./storage/uploads

# ── Mercado Pago (Phase 9: SaaS subscription billing) ────────────────────────
# Test credentials: Mercado Pago Developers → Your integrations → your app → "Test credentials".
# Use the TEST-... values while developing; production ones only on the real server.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000
# Secret used to verify the "x-signature" header of webhook notifications
# (Your integrations → your app → Webhooks → "Secret signature").
MERCADOPAGO_WEBHOOK_SECRET=change-me-webhook-secret
# Development only: email of the TEST BUYER account (replaces the organization owner's email
# as subscription payer, because Mercado Pago requires the payer to be that account).
MERCADOPAGO_TEST_PAYER_EMAIL=test_user_000000000@testuser.com
# Development only: email of the TEST SELLER account that plays a clinic receiving payments (phase 10B).
MERCADOPAGO_TEST_SELLER_EMAIL=test_user_000000000@testuser.com
# OAuth of the Mercado Pago application (Your integrations → your app → "Credenciales de producción"
# / "Client ID" and "Client Secret"). Lets each clinic connect its own Mercado Pago account.
MERCADOPAGO_CLIENT_ID=0000000000000000
MERCADOPAGO_CLIENT_SECRET=change-me-client-secret
# Public URL where Mercado Pago can reach this API (webhooks) and the web (return URLs).
# In development use a tunnel (e.g. ngrok / cloudflared) pointing to localhost:3000.
# Webhook URL to configure in Mercado Pago: <APP_PUBLIC_API_URL>/api/v1/webhooks/mercadopago
APP_PUBLIC_API_URL=https://your-tunnel.ngrok-free.app
APP_PUBLIC_WEB_URL=http://localhost:5173

# ── Online payments (phase 10: clinics collect from their customers) ────────
# Key that encrypts each clinic's Mercado Pago credentials at rest: 32 random bytes in base64
# (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Never change it without re-encrypting; use a different key per environment.
PAYMENT_TOKENS_KEY=
# OAuth redirect URL to register in the Mercado Pago app. Default:
# <APP_PUBLIC_API_URL>/api/v1/oauth/mercadopago/callback
# MERCADOPAGO_OAUTH_REDIRECT_URI=
