# docker-compose variables. The API reads its own file: see apps/api/.env.example
# (database URL, JWT, Mercado Pago credentials…).

# Database
POSTGRES_USER=dentalflow
POSTGRES_PASSWORD=dentalflow_secret
POSTGRES_DB=dentalflow_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dentalflow:dentalflow_secret@localhost:5432/dentalflow_dev

# API
NODE_ENV=development
API_PORT=3000

# JWT — access token (short-lived)
JWT_ACCESS_SECRET=change-me-access-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m

# JWT — refresh token (long-lived, stored hashed in DB)
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Web
VITE_API_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:5173
